@{
    ViewData["Title"] = "Register";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="mb-4 text-center">Create an Account</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Register" asp-controller="Account" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input type="text" name="fullName" class="form-control" placeholder="John Doe" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="john@example.com" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Phone Number (10-15 digits)</label>
            <input type="tel" name="phoneNumber" class="form-control" placeholder="0722123456" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Account Role (Authorization)</label>
            <select name="role" class="form-select">
                <option value="Customer">Customer (Buy Tickets)</option>
                <option value="Organizer">Organizer (Create Events)</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Register</button>
        <p class="mt-3 text-center mb-0">
            Already have an account? <a asp-action="Login">Sign In</a>
        </p>
    </form>
</div>