@{
    ViewData["Title"] = "Create Event";
    var categories = ViewBag.Categories as List<EventTicketing.Models.Category>;
}

<div class="container mt-4" style="max-width: 650px;">
    <h2 class="mb-4">Create New Event</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Event Title</label>
            <input type="text" name="title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3" required></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Location</label>
                <input type="text" name="location" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Event Date & Time</label>
                <input type="datetime-local" name="eventDate" class="form-control" required />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Ticket Price (RON)</label>
                <input type="number" step="0.01" name="ticketPrice" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Available Seats</label>
                <input type="number" name="availableSeats" class="form-control" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Select Categories (Many-to-Many)</label>
            <div class="d-flex flex-wrap gap-3 p-2 border rounded">
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="categoryIds" value="@cat.IdCategory" id="cat_@cat.IdCategory" />
                            <label class="form-check-label" for="cat_@cat.IdCategory">@cat.Name</label>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Event Poster (Max 12 MB, only .jpg / .png)</label>
            <input type="file" name="posterFile" class="form-control" accept=".jpg,.jpeg,.png" required />
        </div>

        <button type="submit" class="btn btn-success w-100">Publish Event</button>
    </form>
</div>