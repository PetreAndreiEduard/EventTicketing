@model List<EventTicketing.Models.Event>
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Events";
    var categories = ViewBag.Categories as List<EventTicketing.Models.Category>;
    var userRole = Context.Session.GetString("UserRole");
}

<div class="container mt-4">
    <div id="eventCarousel" class="carousel slide mb-5 shadow rounded overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active" style="height: 300px; background: linear-gradient(135deg, #1e3c72, #2a5298);">
                <div class="d-flex h-100 align-items-center justify-content-center text-white text-center p-4">
                    <div>
                        <h2>Live Music & Festivals</h2>
                        <p>Book your tickets securely for the best concerts of the year.</p>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="height: 300px; background: linear-gradient(135deg, #4b134f, #c94b4b);">
                <div class="d-flex h-100 align-items-center justify-content-center text-white text-center p-4">
                    <div>
                        <h2>Tech Conferences & Workshops</h2>
                        <p>Connect with industry leaders and upgrade your skills.</p>
                    </div>
                </div>
            </div>
            @foreach (var item in Model.Take(3))
            {
                <div class="carousel-item" style="height: 300px; background-color: #111;">
                    <img src="@item.PosterImagePath" class="d-block w-100 h-100" style="object-fit: cover; opacity: 0.6;" alt="@item.Title" />
                    <div class="carousel-caption d-none d-md-block">
                        <h3>@item.Title</h3>
                        <p>@item.Location - @item.EventDate.ToString("dd MMM yyyy HH:mm")</p>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#eventCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#eventCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Upcoming Events</h2>
        @if (userRole == "Organizer")
        {
            <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
        }
    </div>

    <form method="get" asp-action="Index" class="row g-3 mb-4">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Search by title or location..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat.IdCategory" selected="@(ViewBag.CurrentCategory == cat.IdCategory)">@cat.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-dark w-100">Filter Events</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No events found. If you are an Organizer, click "Create New Event" above!</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle shadow-sm bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Poster</th>
                        <th>Title & Description</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Price</th>
                        <th>Available Seats</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>
                            <td style="width: 120px;">
                                <img src="@ev.PosterImagePath" alt="@ev.Title" class="img-fluid rounded" style="max-height: 80px;" />
                            </td>
                            <td>
                                <strong>@ev.Title</strong>
                                <p class="text-muted small mb-0">@ev.Description</p>
                            </td>
                            <td>@ev.Location</td>
                            <td>@ev.EventDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-success">@ev.TicketPrice.ToString("0.00") RON</td>
                            <td>@ev.AvailableSeats</td>
                            <td>
                                @if (Context.Session.GetInt32("UserId") != null && ev.AvailableSeats > 0)
                                {
                                    <a asp-controller="Tickets" asp-action="Checkout" asp-route-eventId="@ev.IdEvent" class="btn btn-sm btn-success mb-1">
                                        Buy Ticket
                                    </a>
                                }
                                @if (userRole == "Organizer")
                                {
                                    <form asp-action="Delete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ev.IdEvent" />
                                        <button type="submit" class="btn btn-sm btn-danger mb-1" onclick="return confirm('Delete this event?');">Delete</button>
                                    </form>
                                }
                                @if (Context.Session.GetInt32("UserId") == null)
                                {
                                    <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">Login to Buy</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>