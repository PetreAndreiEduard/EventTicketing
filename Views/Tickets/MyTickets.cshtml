@model List<EventTicketing.Models.Ticket>
@{
    ViewData["Title"] = "My Tickets";
    var eventsDict = ViewBag.Events as Dictionary<int, EventTicketing.Models.Event>;
}

<div class="container mt-4">
    <h2 class="mb-4">My Purchased Tickets</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't purchased any tickets yet. <a asp-controller="Events" asp-action="Index">Browse Events</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ticket in Model)
            {
                var ev = (eventsDict != null && eventsDict.ContainsKey(ticket.IdEvent)) ? eventsDict[ticket.IdEvent] : null;
                <div class="col-md-6">
                    <div class="card shadow-sm h-100 border-primary">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <span class="badge bg-success mb-2">@ticket.Status</span>
                                <h5 class="card-title mb-1">@(ev != null ? ev.Title : "Event")</h5>
                                <p class="text-muted small mb-1">@(ev != null ? ev.Location : "")</p>
                                <p class="mb-2"><strong>Code:</strong> <code>@ticket.TicketCode</code></p>
                                <small class="text-secondary">Purchased: @ticket.PurchaseDate.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <div class="text-center ms-3">
                                <img src="@Url.Action("GetQrCode", "Tickets", new { ticketId = ticket.IdTicket })"
                                     alt="Protected QR" style="width: 120px; height: 120px;" class="border rounded p-1" />
                                <div class="small text-muted mt-1">Protected QR</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>